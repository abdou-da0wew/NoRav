{
  "name": "norav",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && bun run engine:build && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "engine:build": "cd proxy-engine && bun run build",
    "engine:typecheck": "cd proxy-engine && bun run typecheck",
    "engine:test": "cd proxy-engine && bun run test",
    "engine:lint": "oxlint proxy-engine/src proxy-engine/tests",
    "engine:format": "prettier --write \"proxy-engine/src/**/*.ts\" \"proxy-engine/tests/**/*.ts\" \"proxy-engine/*.json\" biome.json .prettierrc.json",
    "engine:format:check": "prettier --check \"proxy-engine/src/**/*.ts\" \"proxy-engine/tests/**/*.ts\" \"proxy-engine/*.json\" biome.json .prettierrc.json",
    "engine:imports:fix": "biome check --write --formatter-enabled=false --linter-enabled=false proxy-engine/src proxy-engine/tests",
    "engine:imports:check": "biome check --formatter-enabled=false --linter-enabled=false proxy-engine/src proxy-engine/tests",
    "engine:check": "bun run engine:imports:check && bun run engine:format:check && bun run engine:typecheck && bun run engine:lint && bun run engine:test",
    "engine:start": "NODE_OPTIONS=--max-http-header-size=131072 node proxy-engine/dist/src/index.js"
  },
  "dependencies": {
    "@fontsource-variable/commissioner": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@lucasmarkes/hairline": "^0.5.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.69.0",
    "motion": "^14.9.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "workspaces": [
    "proxy-engine"
  ],
  "packageManager": "bun@1.4.4"
}
